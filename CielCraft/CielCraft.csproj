<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <Description>Crafting helper plugin for Final Fantasy XIV.</Description>
    <PackageProjectUrl>https://github.com/edwingadiel/cielcraft</PackageProjectUrl>
    <!-- Allows compiling the Windows-targeted plugin on macOS/Linux dev machines. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CielCraft.Core/CielCraft.Core.csproj" />
    <ProjectReference Include="../CielCraft.Raphael/CielCraft.Raphael.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native Raphael solver, built by CI (or locally with cargo) before the plugin build. -->
    <None Include="../native/cielcraft-raphael/target/release/cielcraft_raphael.dll"
          Condition="Exists('../native/cielcraft-raphael/target/release/cielcraft_raphael.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="cielcraft_raphael.dll" />
  </ItemGroup>
</Project>
