<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CielCraft.Core/CielCraft.Core.csproj" />
    <ProjectReference Include="../CielCraft.Raphael/CielCraft.Raphael.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      MaintenanceService and the bridge interface depend only on Core, so they
      compile straight into the tests (roadmap 7.2 MaintenanceTests) without
      a reference to the Dalamud-bound plugin project.
    -->
    <Compile Include="../CielCraft/Game/IGameBridge.cs" Link="Seams/IGameBridge.cs" />
    <Compile Include="../CielCraft/Game/MaintenanceService.cs" Link="Seams/MaintenanceService.cs" />
    <!-- The vendor source (roadmap 7.3b) is Dalamud-free too; only its shop
         database reads the sheets, and tests hand it an IVendorDirectory. -->
    <Compile Include="../CielCraft/Sourcing/VendorSource.cs" Link="Seams/VendorSource.cs" />
    <!-- The NPC interactor (roadmap 7.3) is Dalamud-free too; its database is not. -->
    <Compile Include="../CielCraft/Npc/NpcInteractor.cs" Link="Seams/NpcInteractor.cs" />
    <!--
      The exchange source (roadmap 7.17) talks only to Core types, the bridge
      interface and the NPC interfaces, so its offer maths and run flow are
      testable without Dalamud; the sheet reading lives in ExchangeDatabase,
      which is not compiled in here.
    -->
    <Compile Include="../CielCraft/Sourcing/ExchangeSource.cs" Link="Seams/ExchangeSource.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Fishing (roadmap 7.4). The database's lookups, the controller and the
      material source depend only on Core and the bridge interface; the Lumina
      half lives in Game/FishingSheetReader.cs and stays out of the tests.
    -->
    <Compile Include="../CielCraft/Game/FishingDatabase.cs" Link="Seams/FishingDatabase.cs" />
    <Compile Include="../CielCraft/Fishing/FishingActions.cs" Link="Seams/FishingActions.cs" />
    <Compile Include="../CielCraft/Fishing/FishingController.cs" Link="Seams/FishingController.cs" />
    <Compile Include="../CielCraft/Sourcing/FishingSource.cs" Link="Seams/FishingSource.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Host-platform native solver, if built locally (cargo release build in native/cielcraft-raphael). -->
    <None Include="../native/cielcraft-raphael/target/release/cielcraft_raphael.dll"
          Condition="Exists('../native/cielcraft-raphael/target/release/cielcraft_raphael.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="cielcraft_raphael.dll" />
    <None Include="../native/cielcraft-raphael/target/release/libcielcraft_raphael.dylib"
          Condition="Exists('../native/cielcraft-raphael/target/release/libcielcraft_raphael.dylib')"
          CopyToOutputDirectory="PreserveNewest" Link="libcielcraft_raphael.dylib" />
    <None Include="../native/cielcraft-raphael/target/release/libcielcraft_raphael.so"
          Condition="Exists('../native/cielcraft-raphael/target/release/libcielcraft_raphael.so')"
          CopyToOutputDirectory="PreserveNewest" Link="libcielcraft_raphael.so" />
  </ItemGroup>
</Project>
